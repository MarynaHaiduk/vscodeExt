{
  "name": "ext",
  "displayName": "Project Files",
  "description": "VS Code extension for viewing and refreshing project files",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",

  "activationEvents": [
    "onView:projectFiles",
    "onCommand:ext.refresh"
  ],

  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "projectFiles",
          "name": "Project Files",
          "icon": "$(files)"
        }
      ]
    },

    "commands": [
      {
        "command": "ext.refresh",
        "title": "Refresh Project Files",
        "icon": "$(refresh)"
      }
    ],

    "menus": {
      "view/title": [
        {
          "command": "ext.refresh",
          "when": "view == projectFiles",
          "group": "navigation"
        }
      ]
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },

  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },

  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
